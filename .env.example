# Intentionally public Supabase values. The publishable key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PHONE_AUTH_ENABLED=false

# Legacy projects may use this instead. Prefer the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only admin preview. Never use this as production authorization.
BHETAU_ADMIN_DEMO=false

# Optional server-only secret for future trusted jobs/Edge Functions.
# Never prefix this value with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=
