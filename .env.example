# Intentionally public Supabase values. The publishable key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PHONE_AUTH_ENABLED=false

# Legacy projects may use this instead. Prefer the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only admin preview. Never use this as production authorization.
BHETAU_ADMIN_DEMO=false

# Optional server-only secret for future trusted jobs/Edge Functions.
# Never prefix this value with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Maya runs server-side only. `demo` is a deterministic local fallback;
# `gateway` uses Vercel AI Gateway via OIDC or AI_GATEWAY_API_KEY.
MAYA_AI_PROVIDER=demo
AI_GATEWAY_API_KEY=
MAYA_FAST_MODEL=openai/gpt-5.4-mini
MAYA_SMART_MODEL=openai/gpt-5.4
MAYA_SAFETY_MODEL=openai/gpt-5.4-mini
MAYA_TIMEOUT_MS=12000
MAYA_REQUESTS_PER_MINUTE=8
MAYA_FREE_DAILY_LIMIT=20
MAYA_PLUS_DAILY_LIMIT=100

# Optional current provider rates used only for approximate admin cost display.
MAYA_INPUT_USD_PER_MILLION=0
MAYA_OUTPUT_USD_PER_MILLION=0
